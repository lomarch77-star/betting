# ── Match Markets Terminal — environment configuration ──────────────────────
# Copy to .env.local for local overrides. NEVER commit real secrets.
# All values have safe demo defaults — the app runs fully offline with none set.

# Path of the SQLite database file (relative to repo root or absolute).
# The DB layer is isolated behind a repository interface so PostgreSQL can be
# substituted by providing a PG-backed implementation of the same interface.
DATABASE_PATH=./data/terminal.sqlite

# Demo dataset seed (integer). Changing it regenerates a different synthetic
# league universe. Deterministic for a given seed.
DEMO_SEED=42

# ── API access control ──────────────────────────────────────────────────────
# Read endpoints are open. Research/admin mutations require an API key.
# If unset, the app runs in DEMO_AUTH_MODE: mutations are allowed but every
# request is tagged actor="demo-operator" in the audit log.
RESEARCH_API_KEY=
ADMIN_API_KEY=

# Requests per minute per IP for /api/* (token bucket).
API_RATE_LIMIT_PER_MIN=240

# Anchor date used by the demo generator (YYYY-MM-DD). Empty = today (UTC).
# Pinning this makes the whole dataset reproducible across machines.
DEMO_ANCHOR_DATE=
